# App
TRIPMATE_DEMO_MODE=false
TRIPMATE_DATABASE_URL=sqlite:///./tripmate.db
TRIPMATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional live Gemma 4. Obtain a key from Google AI Studio.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Public-data services used in normal mode. These normally need no keys, but
# please observe their provider usage policies before production deployment.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

